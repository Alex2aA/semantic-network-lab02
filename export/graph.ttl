@prefix ns1: <https://example.org/semnet/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sem: <https://example.org/semnet/vocab/> .

ns1:criterion a rdfs:Class ;
    rdfs:label "Критерий выбора"@ru ;
    sem:definition "Параметр, по которому сравниваются кандидатные СУБД при выборе для проекта."@ru .

ns1:criterion_data a rdfs:Class ;
    rdfs:label "Критерий модели данных"@ru ;
    rdfs:subClassOf ns1:criterion ;
    sem:definition "Критерий, связанный с моделью данных и форматом хранения."@ru ;
    sem:source "Модельное допущение" .

ns1:criterion_ops a rdfs:Class ;
    rdfs:label "Критерий эксплуатации"@ru ;
    rdfs:subClassOf ns1:criterion ;
    sem:definition "Критерий, связанный с лицензированием, стоимостью и сложностью эксплуатации."@ru ;
    sem:source "Модельное допущение" .

ns1:criterion_perf a rdfs:Class ;
    rdfs:label "Критерий производительности"@ru ;
    rdfs:subClassOf ns1:criterion ;
    sem:definition "Критерий, связанный с производительностью системы хранения."@ru ;
    sem:source "Модельное допущение" .

ns1:criterion_scale a rdfs:Class ;
    rdfs:label "Критерий масштабирования"@ru ;
    rdfs:subClassOf ns1:criterion_perf ;
    sem:definition "Критерий горизонтального масштабирования под растущей нагрузкой."@ru ;
    sem:source "Модельное допущение" .

ns1:dbms a rdfs:Class ;
    rdfs:label "СУБД"@ru ;
    sem:definition "Программная система для создания, хранения и обработки данных, доступной множеству пользователей."@ru .

ns1:dbms_doc a rdfs:Class ;
    rdfs:label "Документо-ориентированная СУБД"@ru ;
    rdfs:subClassOf ns1:dbms ;
    sem:definition "СУБД, хранящая данные в виде документов (JSON/BSON) без жёсткой схемы."@ru ;
    sem:source "Модельное допущение" .

ns1:dbms_graph a rdfs:Class ;
    rdfs:label "Графовая СУБД"@ru ;
    rdfs:subClassOf ns1:dbms ;
    sem:definition "СУБД, хранящая сущности как вершины и рёбра и оптимизированная под обход связей."@ru ;
    sem:source "Модельное допущение" .

ns1:dbms_kv a rdfs:Class ;
    rdfs:label "СУБД ключ–значение"@ru ;
    rdfs:subClassOf ns1:dbms ;
    sem:definition "СУБД пар «ключ–значение» для простого и быстрого доступа к значениям по ключу."@ru ;
    sem:source "Модельное допущение" .

ns1:dbms_oltp a rdfs:Class ;
    rdfs:label "Операционная (OLTP) СУБД"@ru ;
    rdfs:subClassOf ns1:dbms_rel ;
    sem:definition "Реляционная СУБД для транзакционных нагрузок: много коротких операций записи и чтения."@ru ;
    sem:source "Модельное допущение" .

ns1:dbms_rel a rdfs:Class ;
    rdfs:label "Реляционная СУБД"@ru ;
    rdfs:subClassOf ns1:dbms ;
    sem:definition "СУБД, данные которой организованы в таблицы с фиксированной схемой и связями между ними."@ru ;
    sem:source "Модельное допущение" .

ns1:project a rdfs:Class ;
    rdfs:label "Проект"@ru ;
    sem:definition "Информационная система, для которой подбирается СУБД."@ru .

ns1:requirement a rdfs:Class ;
    rdfs:label "Требование проекта"@ru ;
    sem:definition "Требование проекта к системе хранения данных."@ru .

ns1:crit_license a ns1:criterion_ops,
        sem:Instance ;
    rdfs:label "Тип лицензирования"@ru ;
    sem:definition "Условия использования: открытая или коммерческая лицензия."@ru ;
    sem:source "Модельное допущение" .

ns1:evaluated_by a rdf:Property ;
    rdfs:label "оценивается по"@ru ;
    rdfs:domain ns1:requirement ;
    rdfs:range ns1:criterion ;
    sem:meaning "Требование проекта оценивается по критерию выбора СУБД. Читается: «Требование — оценивается по → Критерий»."@ru .

ns1:has_value a rdf:Property ;
    rdfs:label "имеет значение"@ru ;
    rdfs:domain ns1:dbms ;
    sem:meaning "СУБД имеет значение свойства (лицензия, стоимость). Читается: «СУБД — имеет значение → Значение»."@ru .

ns1:instance a rdf:Property ;
    rdfs:label "экземпляр"@ru ;
    sem:meaning "Конкретный объект принадлежит классу (ISA / instance-of). Читается: «A — экземпляр → B»."@ru .

ns1:mysql a ns1:dbms_oltp,
        sem:Instance ;
    rdfs:label "MySQL"@ru ;
    ns1:has_value ns1:val_cost_free,
        ns1:val_lic_open ;
    ns1:satisfies ns1:req_acid,
        ns1:req_scale ;
    sem:definition "Популярная реляционная СУБД открытого кода."@ru ;
    sem:source "MySQL Documentation",
        "Модельное допущение" .

ns1:oracle a ns1:dbms_oltp,
        sem:Instance ;
    rdfs:label "Oracle Database"@ru ;
    ns1:has_value ns1:val_cost_paid,
        ns1:val_lic_comm ;
    ns1:satisfies ns1:req_acid,
        ns1:req_scale ;
    sem:definition "Коммерческая реляционная СУБД корпоративного класса."@ru ;
    sem:source "Oracle Database Documentation",
        "Модельное допущение" .

ns1:presents a rdf:Property ;
    rdfs:label "предъявляет"@ru ;
    rdfs:domain ns1:project ;
    rdfs:range ns1:requirement ;
    sem:meaning "Проект предъявляет требование к системе хранения данных. Читается: «Проект — предъявляет → Требование»."@ru .

ns1:project_iot a ns1:project,
        sem:Instance ;
    rdfs:label "Проект «Сервис телеметрии»"@ru ;
    ns1:presents ns1:req_latency,
        ns1:req_scale ;
    ns1:recommends ns1:mongodb ;
    sem:definition "Сбор и хранение телеметрии датчиков и устройств."@ru ;
    sem:source "Модельное допущение" .

ns1:project_reco a ns1:project,
        sem:Instance ;
    rdfs:label "Проект «Сервис рекомендаций»"@ru ;
    ns1:presents ns1:req_graph,
        ns1:req_latency ;
    ns1:recommends ns1:neo4j ;
    sem:definition "Подбор рекомендаций на основе связей между объектами."@ru ;
    sem:source "Модельное допущение" .

ns1:project_shop a ns1:project,
        sem:Instance ;
    rdfs:label "Проект «Онлайн-магазин»"@ru ;
    ns1:presents ns1:req_acid,
        ns1:req_docs,
        ns1:req_latency,
        ns1:req_scale ;
    ns1:recommends ns1:postgresql ;
    sem:definition "Интернет-магазин: каталог товаров, заказы, оплата."@ru ;
    sem:source "Модельное допущение" .

ns1:recommends a rdf:Property ;
    rdfs:label "рекомендует"@ru ;
    rdfs:domain ns1:project ;
    rdfs:range ns1:dbms ;
    sem:meaning "Итоговая рекомендация эксперта: проекту подходит указанная СУБД. Читается: «Проект — рекомендует → СУБД»."@ru .

ns1:redis a ns1:dbms_kv,
        sem:Instance ;
    rdfs:label "Redis"@ru ;
    ns1:has_value ns1:val_cost_free,
        ns1:val_lic_open ;
    ns1:satisfies ns1:req_latency,
        ns1:req_simple_deploy ;
    sem:definition "СУБД ключ–значение с хранением данных в оперативной памяти."@ru ;
    sem:source "Redis Documentation",
        "Модельное допущение" .

ns1:satisfies a rdf:Property ;
    rdfs:label "удовлетворяет"@ru ;
    rdfs:domain ns1:dbms ;
    rdfs:range ns1:requirement ;
    sem:meaning "СУБД покрывает требование проекта по данным модели. Читается: «СУБД — удовлетворяет → Требование»."@ru .

ns1:sqlite a ns1:dbms_oltp,
        sem:Instance ;
    rdfs:label "SQLite"@ru ;
    ns1:has_value ns1:val_cost_free,
        ns1:val_lic_open ;
    ns1:satisfies ns1:req_acid,
        ns1:req_simple_deploy ;
    sem:definition "Встраиваемая реляционная СУБД, работающая в одном процессе без сервера."@ru ;
    sem:source "SQLite Documentation",
        "Модельное допущение" .

ns1:subclass a rdf:Property ;
    rdfs:label "подкласс"@ru ;
    sem:meaning "Класс A является более частным случаем класса B (AKO / subclass-of). Читается: «A — подкласс → B»."@ru .

ns1:crit_complexity a ns1:criterion_ops,
        sem:Instance ;
    rdfs:label "Сложность эксплуатации"@ru ;
    sem:definition "Усилия на развёртывание, настройку и поддержку системы."@ru ;
    sem:source "Модельное допущение" .

ns1:crit_consistency a ns1:criterion_data,
        sem:Instance ;
    rdfs:label "Согласованность данных"@ru ;
    sem:definition "Модель гарантий при одновременной записи и чтении."@ru ;
    sem:source "Модельное допущение" .

ns1:mongodb a ns1:dbms_doc,
        sem:Instance ;
    rdfs:label "MongoDB"@ru ;
    ns1:has_value ns1:val_cost_free,
        ns1:val_lic_open ;
    ns1:satisfies ns1:req_docs,
        ns1:req_latency,
        ns1:req_scale ;
    sem:definition "Документо-ориентированная СУБД с гибкой схемой и хранением BSON."@ru ;
    sem:source "MongoDB Documentation",
        "Модельное допущение" .

ns1:neo4j a ns1:dbms_graph,
        sem:Instance ;
    rdfs:label "Neo4j"@ru ;
    ns1:has_value ns1:val_cost_free,
        ns1:val_lic_open ;
    ns1:satisfies ns1:req_graph ;
    sem:definition "Графовая СУБД с ядром, ориентированным на обход связей между объектами."@ru ;
    sem:source "Neo4j Documentation",
        "Модельное допущение" .

ns1:postgresql a ns1:dbms_oltp,
        sem:Instance ;
    rdfs:label "PostgreSQL"@ru ;
    ns1:has_value ns1:val_cost_free,
        ns1:val_lic_open ;
    ns1:satisfies ns1:req_acid,
        ns1:req_docs,
        ns1:req_scale ;
    sem:definition "Свободная реляционная СУБД с развитой системой транзакций и расширений."@ru ;
    sem:source "PostgreSQL Documentation",
        "Модельное допущение" .

ns1:val_cost_paid a sem:Value ;
    rdfs:label "Стоимость: платная"@ru ;
    sem:definition "Значение свойства «стоимость» — требуется оплата лицензии."@ru .

ns1:val_lic_comm a sem:Value ;
    rdfs:label "Лицензия: коммерческая"@ru ;
    sem:definition "Значение свойства «лицензия» — использование по коммерческому контракту."@ru .

ns1:crit_latency a ns1:criterion_scale,
        sem:Instance ;
    rdfs:label "Задержка операций"@ru ;
    sem:definition "Время отклика типовых операций чтения и записи."@ru ;
    sem:source "Модельное допущение" .

ns1:crit_model a ns1:criterion_data,
        sem:Instance ;
    rdfs:label "Модель данных и формат"@ru ;
    sem:definition "Способ представления данных и работа со схемой."@ru ;
    sem:source "Модельное допущение" .

ns1:req_graph a ns1:requirement,
        sem:Instance ;
    rdfs:label "Граф связей"@ru ;
    ns1:evaluated_by ns1:crit_model ;
    sem:definition "Хранение и быстрый обход связей между объектами."@ru ;
    sem:source "Модельное допущение" .

ns1:req_simple_deploy a ns1:requirement,
        sem:Instance ;
    rdfs:label "Простое развёртывание"@ru ;
    ns1:evaluated_by ns1:crit_complexity ;
    sem:definition "Запуск на одной машине без отдельного кластера."@ru ;
    sem:source "Модельное допущение" .

ns1:req_docs a ns1:requirement,
        sem:Instance ;
    rdfs:label "Хранение документов"@ru ;
    ns1:evaluated_by ns1:crit_model ;
    sem:definition "Структурированные документы переменной формы (JSON)."@ru ;
    sem:source "Модельное допущение" .

ns1:req_acid a ns1:requirement,
        sem:Instance ;
    rdfs:label "Транзакции ACID"@ru ;
    ns1:evaluated_by ns1:crit_consistency ;
    sem:definition "Гарантии целостности данных при конкурентной записи."@ru ;
    sem:source "Модельное допущение" .

ns1:req_latency a ns1:requirement,
        sem:Instance ;
    rdfs:label "Низкая задержка чтения"@ru ;
    ns1:evaluated_by ns1:crit_latency ;
    sem:definition "Быстрый отклик системы на операции чтения."@ru ;
    sem:source "Модельное допущение" .

ns1:req_scale a ns1:requirement,
        sem:Instance ;
    rdfs:label "Горизонтальное масштабирование"@ru ;
    ns1:evaluated_by ns1:crit_latency ;
    sem:definition "Распределение нагрузки на несколько узлов кластера."@ru ;
    sem:source "Модельное допущение" .

ns1:val_cost_free a sem:Value ;
    rdfs:label "Стоимость: бесплатная"@ru ;
    sem:definition "Значение свойства «стоимость» — нет платы за использование."@ru .

ns1:val_lic_open a sem:Value ;
    rdfs:label "Лицензия: открытая"@ru ;
    sem:definition "Значение свойства «лицензия» — свободное использование по открытой лицензии."@ru .

