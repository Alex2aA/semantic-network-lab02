digraph SemanticNetwork {
  rankdir=LR;
  graph [fontname="Helvetica", labelloc="t", labeljust="c", pad="0.3", nodesep=0.55, ranksep=1.6, newrank=true];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#37474F", arrowsize=0.7];
  label="Фрагмент 1. Иерархия классов и принадлежность экземпляров";
  subgraph cluster_legend {
    label="Легенда"; fontsize=11; fontname="Helvetica";
    style="rounded"; color="#90A4AE"; bgcolor="#FAFAFA";
    lg_class [label="Класс", shape=box, style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0", fontsize=10];
    lg_inst [label="Экземпляр", shape=ellipse, style=filled, fillcolor="#C8E6C9", color="#2E7D32", fontsize=10];
    lg_val [label="Значение свойства", shape=note, style=filled, fillcolor="#FFF59D", color="#F9A825", fontsize=10];
    lg_dir [label="Стрелка = направление факта,\nподпись = тип отношения", shape=plaintext, fontsize=9];
    lg_class -> lg_inst [style=invis];
    lg_inst -> lg_val [style=invis];
    lg_val -> lg_dir [style=invis];
  }
  subgraph "cluster_0" {
    label="Иерархия: типы СУБД"; fontsize=11; fontname="Helvetica";
    style="rounded,filled"; fillcolor="#E3F2FD"; color="#78909C";
    "dbms" [label="СУБД\\n[dbms]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "dbms_rel" [label="Реляционная СУБД\\n[dbms_rel]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "dbms_oltp" [label="Операционная (OLTP) СУБД\\n[dbms_oltp]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "dbms_doc" [label="Документо-ориентированная СУБД\\n[dbms_doc]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "dbms_kv" [label="СУБД ключ–значение\\n[dbms_kv]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "dbms_graph" [label="Графовая СУБД\\n[dbms_graph]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
  }
  subgraph "cluster_1" {
    label="Иерархия: критерии"; fontsize=11; fontname="Helvetica";
    style="rounded,filled"; fillcolor="#E8F5E9"; color="#78909C";
    "criterion" [label="Критерий выбора\\n[criterion]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "criterion_data" [label="Критерий модели данных\\n[criterion_data]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "criterion_perf" [label="Критерий производительности\\n[criterion_perf]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "criterion_scale" [label="Критерий масштабирования\\n[criterion_scale]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "criterion_ops" [label="Критерий эксплуатации\\n[criterion_ops]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
  }
  subgraph "cluster_2" {
    label="Классы: проект и требования"; fontsize=11; fontname="Helvetica";
    style="rounded,filled"; fillcolor="#FFF8E1"; color="#78909C";
    "project" [label="Проект\\n[project]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
    "requirement" [label="Требование проекта\\n[requirement]", shape="box", style="rounded,filled", fillcolor="#BBDEFB", color="#1565C0"];
  }
  subgraph "cluster_3" {
    label="Экземпляры: СУБД"; fontsize=11; fontname="Helvetica";
    style="rounded,filled"; fillcolor="#F3E5F5"; color="#78909C";
    "postgresql" [label="PostgreSQL\\n[postgresql]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "mysql" [label="MySQL\\n[mysql]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "sqlite" [label="SQLite\\n[sqlite]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "oracle" [label="Oracle Database\\n[oracle]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "mongodb" [label="MongoDB\\n[mongodb]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "redis" [label="Redis\\n[redis]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "neo4j" [label="Neo4j\\n[neo4j]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
  }
  subgraph "cluster_4" {
    label="Экземпляры: проекты"; fontsize=11; fontname="Helvetica";
    style="rounded,filled"; fillcolor="#ECEFF1"; color="#78909C";
    "project_shop" [label="Проект «Онлайн-магазин»\\n[project_shop]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "project_iot" [label="Проект «Сервис телеметрии»\\n[project_iot]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "project_reco" [label="Проект «Сервис рекомендаций»\\n[project_reco]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
  }
  subgraph "cluster_5" {
    label="Экземпляры: требования"; fontsize=11; fontname="Helvetica";
    style="rounded,filled"; fillcolor="#E0F7FA"; color="#78909C";
    "req_acid" [label="Транзакции ACID\\n[req_acid]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "req_docs" [label="Хранение документов\\n[req_docs]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "req_scale" [label="Горизонтальное масштабирование\\n[req_scale]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "req_graph" [label="Граф связей\\n[req_graph]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "req_latency" [label="Низкая задержка чтения\\n[req_latency]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "req_simple_deploy" [label="Простое развёртывание\\n[req_simple_deploy]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
  }
  subgraph "cluster_6" {
    label="Экземпляры: критерии"; fontsize=11; fontname="Helvetica";
    style="rounded,filled"; fillcolor="#FBE9E7"; color="#78909C";
    "crit_consistency" [label="Согласованность данных\\n[crit_consistency]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "crit_model" [label="Модель данных и формат\\n[crit_model]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "crit_latency" [label="Задержка операций\\n[crit_latency]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "crit_license" [label="Тип лицензирования\\n[crit_license]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
    "crit_complexity" [label="Сложность эксплуатации\\n[crit_complexity]", shape="ellipse", style="filled", fillcolor="#C8E6C9", color="#2E7D32"];
  }
  "dbms_rel" -> "dbms" [label="подкласс", style=dashed, color="#546E7A"];
  "dbms_oltp" -> "dbms_rel" [label="подкласс", style=dashed, color="#546E7A"];
  "dbms_doc" -> "dbms" [label="подкласс", style=dashed, color="#546E7A"];
  "dbms_kv" -> "dbms" [label="подкласс", style=dashed, color="#546E7A"];
  "dbms_graph" -> "dbms" [label="подкласс", style=dashed, color="#546E7A"];
  "criterion_data" -> "criterion" [label="подкласс", style=dashed, color="#546E7A"];
  "criterion_perf" -> "criterion" [label="подкласс", style=dashed, color="#546E7A"];
  "criterion_scale" -> "criterion_perf" [label="подкласс", style=dashed, color="#546E7A"];
  "criterion_ops" -> "criterion" [label="подкласс", style=dashed, color="#546E7A"];
  "postgresql" -> "dbms_oltp" [label="экземпляр", style=dashed, color="#546E7A"];
  "mysql" -> "dbms_oltp" [label="экземпляр", style=dashed, color="#546E7A"];
  "sqlite" -> "dbms_oltp" [label="экземпляр", style=dashed, color="#546E7A"];
  "oracle" -> "dbms_oltp" [label="экземпляр", style=dashed, color="#546E7A"];
  "mongodb" -> "dbms_doc" [label="экземпляр", style=dashed, color="#546E7A"];
  "redis" -> "dbms_kv" [label="экземпляр", style=dashed, color="#546E7A"];
  "neo4j" -> "dbms_graph" [label="экземпляр", style=dashed, color="#546E7A"];
  "project_shop" -> "project" [label="экземпляр", style=dashed, color="#546E7A"];
  "project_iot" -> "project" [label="экземпляр", style=dashed, color="#546E7A"];
  "project_reco" -> "project" [label="экземпляр", style=dashed, color="#546E7A"];
  "req_acid" -> "requirement" [label="экземпляр", style=dashed, color="#546E7A"];
  "req_docs" -> "requirement" [label="экземпляр", style=dashed, color="#546E7A"];
  "req_scale" -> "requirement" [label="экземпляр", style=dashed, color="#546E7A"];
  "req_graph" -> "requirement" [label="экземпляр", style=dashed, color="#546E7A"];
  "req_latency" -> "requirement" [label="экземпляр", style=dashed, color="#546E7A"];
  "req_simple_deploy" -> "requirement" [label="экземпляр", style=dashed, color="#546E7A"];
  "crit_consistency" -> "criterion_data" [label="экземпляр", style=dashed, color="#546E7A"];
  "crit_model" -> "criterion_data" [label="экземпляр", style=dashed, color="#546E7A"];
  "crit_latency" -> "criterion_scale" [label="экземпляр", style=dashed, color="#546E7A"];
  "crit_license" -> "criterion_ops" [label="экземпляр", style=dashed, color="#546E7A"];
  "crit_complexity" -> "criterion_ops" [label="экземпляр", style=dashed, color="#546E7A"];
}